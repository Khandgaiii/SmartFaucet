# Firebase — Project settings → Your apps → Web app → Firebase SDK snippet (config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — Google Analytics (same firebaseConfig as Console); omit if unused
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: canonical site URL for links (defaults to window.origin in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# For Firebase Hosting deploys, add `.env.production.local` with your live URL, e.g.:
# NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.web.app

# Google Sign-In — Web client ID (ends with .apps.googleusercontent.com)
# Required for native Android/iOS (Capacitor). Web can use Firebase popup without it, but keep it set for one config.
#
# How to get it:
# 1) Open Google Cloud Console: https://console.cloud.google.com/ — pick the SAME project Firebase uses
#    (Firebase Console → Project settings → General → "Project ID" / linked GCP project).
# 2) APIs & Services → Credentials → "+ Create credentials" is NOT needed if one exists:
#    under "OAuth 2.0 Client IDs", open the client named "Web client" (type: Web application).
# 3) Copy "Client ID" into NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID below.
# 4) Firebase Console → Authentication → Sign-in method → enable "Google".
# 5) Android: add your debug/release SHA-1 in Firebase → Project settings → Your apps → Android,
#    so Google Sign-In returns tokens for your keystore.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
